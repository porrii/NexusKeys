# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code local session data
.claude/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android signing — never commit keystores or their passwords.
android/local.properties
android/key.properties
*.jks
*.keystore

# Local environment / secrets
*.env

# Generated Windows platform (regenerated later via `flutter create --platforms=windows .`)
/windows/

# Flutter tooling metadata (SDK revision/channel used to scaffold the
# project) — internal to local tooling, not meaningful to anyone cloning
# the repo.
/.metadata

# Gradle's top-level build output (distinct from android/app/{debug,profile,release}
# above, which only cover the app module).
/android/build/

